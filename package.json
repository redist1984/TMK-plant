{
  "name": "tmk-plant-tools",
  "private": true,
  "description": "Инструменты проекта: офлайн-сборка, контент для APK, проверки геометрии модели, дымовой тест",
  "scripts": {
    "check": "node tools/ci-check.js",
    "smoke": "node tools/smoke-test.js",
    "smoke:offline": "node tools/smoke-test.js --offline dist-offline/TMK-plant-offline-lite.html",
    "offline": "node tools/build-offline.js",
    "offline:pdf": "node tools/build-offline.js --with-pdf",
    "android:assets": "node tools/build-android-assets.js",
    "geometry": "node tools/geometry/run.js",
    "geometry:baseline": "node tools/geometry/run.js --update-baseline",
    "audit": "node tools/audit-model.js",
    "twin": "node twin/selftest.js",
    "twin:ilk": "node twin/interlocks.selftest.js",
    "twin:gen": "node twin/gen-interlocks.js",
    "flow-labels": "node tools/check-flow-labels.js"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
